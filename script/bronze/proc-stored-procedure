/*
========================================================================================================
STORED PROCEDURE: Load_bronze
========================================================================================================
Script Purpose:
    Loads data from the CRM and ERP CSV source files into the Bronze layer tables.
    Each target table is truncated before its CSV data is loaded.

    The procedure prints the batch start and end times and retains the existing
    per-table start and end time measurements.

Tables Loaded:
    CRM: bronze.crm_cust_info, bronze.crm_prd_info, bronze.crm_sales_details
    ERP: bronze.erp_CUST_AZ12, bronze.erp_loc_A101, bronze.erp_PX_CAT_G1V2

Usage:
    EXEC dbo.Load_bronze;
========================================================================================================
*/

USE [DATAWAREHOUSE]
GO

SET ANSI_NULLS ON
GO

SET QUOTED_IDENTIFIER ON
GO

CREATE   PROCEDURE [dbo].[Load_bronze]
AS
BEGIN
    DECLARE @Start_time DATETIME, @End_time DATETIME
    DECLARE @BatchStartTime DATETIME, @BatchEndTime DATETIME

    BEGIN TRY
        SET @BatchStartTime = GETDATE();
        PRINT 'Batch start time: ' + CONVERT(NVARCHAR(19), @BatchStartTime, 120);

        PRINT '===============================';
        PRINT 'Loading the Bronze Layer';
        PRINT '===============================';

        PRINT '------------------------------';
        PRINT 'Loading CRM';
        PRINT '-------------------------------';

        SET @Start_time = GETDATE();

        --------Truncating the bronze.crm_cust-------------
        PRINT '>>>>>>>Truncating the table: bronze.crm_cust';
        TRUNCATE TABLE BRONZE.crm_cust_info

        -------Inserting data into: bronze.crm_cust_info-------
        PRINT '>>>>>>> Inserting data into:bronze.crm_cust_info';
        BULK INSERT BRONZE.crm_cust_info
        FROM 'C:\Users\HP\Desktop\SQL PROJECTS BEGINNERS\sql-data-warehouse-project-main\datasets\source_crm\cust_info.csv'
        WITH (
            FIRSTROW = 2,
            FIELDTERMINATOR = ',',
            TABLOCK
        )
        SET @End_time = GETDATE();

        SET @Start_time = GETDATE();

        -------Truncating the table:bronze.crm_prd_info-------
        PRINT '>>>>>>>Truncating the table: bronze.crm_prd_info';
        TRUNCATE TABLE BRONZE.crm_prd_info

        -------Inserting data into:bronze.crm_prd_info--------
        PRINT '>>>>>>> Inserting data into:bronze.crm_prd_info';
        BULK INSERT BRONZE.crm_prd_info
        FROM 'C:\Users\HP\Desktop\SQL PROJECTS BEGINNERS\sql-data-warehouse-project-main\datasets\source_crm\prd_info.csv'
        WITH (
            FIRSTROW = 2,
            FIELDTERMINATOR = ',',
            TABLOCK
        )
        SET @End_time = GETDATE();

        SET @Start_time = GETDATE();

        -------Truncating the table:bronze.crm_sales_details-------
        PRINT '>>>>>>Truncating the table: bronze.crm_sales_details';
        TRUNCATE TABLE BRONZE.crm_sales_details

        -------Inserting data into:bronze.crm_sales_details-------
        PRINT '>>>>>>> Inserting data into:bronze.crm_sales_details';
        BULK INSERT BRONZE.crm_sales_details
        FROM 'C:\Users\HP\Desktop\SQL PROJECTS BEGINNERS\sql-data-warehouse-project-main\datasets\source_crm\sales_details.csv'
        WITH (
            FIRSTROW = 2,
            FIELDTERMINATOR = ',',
            TABLOCK
        );
        SET @End_time = GETDATE();

        PRINT '------------------------------';
        PRINT 'Loading ERP';
        PRINT '-------------------------------';

        SET @Start_time = GETDATE();

        -------Truncating the table:bronze.erp_CUST_AZ12-------
        PRINT '>>>>>>>Truncating the table: bronze.erp_CUST_AZ12';
        TRUNCATE TABLE BRONZE.erp_CUST_AZ12

        -------Inserting into the table:bronze.erp_CUST-AZ12-------
        PRINT '>>>>>>> Inserting data into:bronze.erp_CUST_AZ12';
        BULK INSERT BRONZE.erp_CUST_AZ12
        FROM 'C:\Users\HP\Desktop\SQL PROJECTS BEGINNERS\sql-data-warehouse-project-main\datasets\source_erp\CUST_AZ12.csv'
        WITH (
            FIRSTROW = 2,
            FIELDTERMINATOR = ',',
            TABLOCK
        );
        SET @End_time = GETDATE();

        SET @Start_time = GETDATE();

        -------Truncating the table:bronze.erp_loc_A101-------
        PRINT '>>>>>>>Truncating the table: bronze.erp_loc_A101';
        TRUNCATE TABLE BRONZE.erp_loc_A101

        -------Inserting into the table:bronze.erp_loc_A101-------
        PRINT '>>>>>>> Inserting data into:bronze.erp_loc_A101';
        BULK INSERT BRONZE.erp_loc_A101
        FROM 'C:\Users\HP\Desktop\SQL PROJECTS BEGINNERS\sql-data-warehouse-project-main\datasets\source_erp\loc_A101.csv'
        WITH (
            FIRSTROW = 2,
            FIELDTERMINATOR = ',',
            TABLOCK
        )
        SET @End_time = GETDATE();

        SET @Start_time = GETDATE();

        -------Truncating the table: bronze:bronze.PX_CAT_G1V2-------
        PRINT '>>>>>>>Truncating the table: bronze.PX_CAT_G1V2';
        TRUNCATE TABLE BRONZE.erp_PX_CAT_G1V2

        -------Inserting data into: bronze.erp_PX-CAT_G1V2-------
        PRINT '>>>>>>> Inserting data into:bronze.erp_PX_CAT_G1V2';
        BULK INSERT BRONZE.erp_PX_CAT_G1V2
        FROM 'C:\Users\HP\Desktop\SQL PROJECTS BEGINNERS\sql-data-warehouse-project-main\datasets\source_erp\PX_CAT_G1V2.csv'
        WITH (
            FIRSTROW = 2,
            FIELDTERMINATOR = ',',
            TABLOCK
        )
        SET @End_time = GETDATE();

        PRINT '>>>LOADING DURATION:'
            + CAST(DATEDIFF(SECOND, @Start_time, @End_time) AS NVARCHAR)
            + ' seconds'

        SET @BatchEndTime = GETDATE();
        PRINT 'Batch end time: ' + CONVERT(NVARCHAR(19), @BatchEndTime, 120);
    END TRY

    BEGIN CATCH
        PRINT '================================================';
        PRINT '!!! ERROR OCCURRED DURING LOADING BRONZE LAYER!!';
        PRINT 'Error Message:' + ERROR_MESSAGE();
        PRINT 'Error Number:' + CAST(ERROR_NUMBER() AS NVARCHAR);
        PRINT 'Error Line:' + CAST(ERROR_LINE() AS NVARCHAR);
        PRINT 'Error severity;' + CAST(ERROR_SEVERITY() AS NVARCHAR);
        PRINT '================================================';
    END CATCH
END
GO

EXEC Load_bronze
GO
