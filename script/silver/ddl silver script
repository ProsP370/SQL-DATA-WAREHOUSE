/*
========================================================================================================
DDL SCRIPT: Creating the Silver tables
========================================================================================================
Script purpose:
Creates six tables in the SILVER schema. Drops each table first if it already exists.
Run this script to redefine the table structures.
========================================================================================================
*/

IF SCHEMA_ID('SILVER') IS NULL
    EXEC('CREATE SCHEMA SILVER');
GO

IF OBJECT_ID('SILVER.crm_cust_info', 'U') IS NOT NULL
    DROP TABLE SILVER.crm_cust_info;
GO

CREATE TABLE [SILVER].[crm_cust_info] (
    [Cst_id] [int] NULL,
    [Cst_key] [nvarchar](50) NULL,
    [Cst_firstname] [nvarchar](50) NULL,
    [Cst_lastname] [nvarchar](50) NULL,
    [Cst_marital_status] [nvarchar](50) NULL,
    [Cst_gndr] [nvarchar](50) NULL,
    [Cst_create_date] [date] NULL
);
GO

IF OBJECT_ID('SILVER.crm_prd_info', 'U') IS NOT NULL
    DROP TABLE SILVER.crm_prd_info;
GO

CREATE TABLE [SILVER].[crm_prd_info] (
    [Prd_id] [int] NULL,
    [Prd_key] [nvarchar](50) NULL,
    [Prd_nm] [nvarchar](50) NULL,
    [Prd_cost] [int] NULL,
    [Prd_line] [nvarchar](50) NULL,
    [Prd_start_dt] [date] NULL,
    [Prd_end_dt] [date] NULL
);
GO

IF OBJECT_ID('SILVER.crm_sales_details', 'U') IS NOT NULL
    DROP TABLE SILVER.crm_sales_details;
GO

CREATE TABLE [SILVER].[crm_sales_details] (
    [sls_ord_num] [nvarchar](50) NULL,
    [sls_prd_key] [nvarchar](50) NULL,
    [sls_cust_id] [int] NULL,
    [sls_order_dt] [int] NULL,
    [sls_ship_dt] [int] NULL,
    [sls_due_dt] [int] NULL,
    [sls_sales] [int] NULL,
    [sls_quantity] [int] NULL,
    [sls_price] [int] NULL
);
GO

IF OBJECT_ID('SILVER.erp_CUST_AZ12', 'U') IS NOT NULL
    DROP TABLE SILVER.erp_CUST_AZ12;
GO

CREATE TABLE [SILVER].[erp_CUST_AZ12] (
    [erp_CID] [nvarchar](50) NULL,
    [erp_BDATE] [date] NULL,
    [erp_GEN] [nvarchar](50) NULL
);
GO

IF OBJECT_ID('SILVER.erp_loc_A101', 'U') IS NOT NULL
    DROP TABLE SILVER.erp_loc_A101;
GO

CREATE TABLE [SILVER].[erp_loc_A101] (
    [erp_CID] [nvarchar](50) NULL,
    [erp_CNTRY] [nvarchar](50) NULL
);
GO

IF OBJECT_ID('SILVER.erp_PX_CAT_G1V2', 'U') IS NOT NULL
    DROP TABLE SILVER.erp_PX_CAT_G1V2;
GO

CREATE TABLE [SILVER].[erp_PX_CAT_G1V2] (
    [erp_ID] [nvarchar](50) NULL,
    [erp_CAT] [nvarchar](50) NULL,
    [erp_SUBCAT] [nvarchar](50) NULL,
    [erp_MAINTENANCE] [nvarchar](50) NULL
);
GO
