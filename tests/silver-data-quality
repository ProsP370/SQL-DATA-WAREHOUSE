/*
Purpose:
These queries check Bronze CRM and ERP data before the transformations in
silver.load_silver. They identify missing or duplicate IDs, blank values,
unexpected codes, invalid dates, and inconsistent sales values. Run them
before the Silver load and review any returned rows.
*/


/* ============================================================
   CRM DATA QUALITY TESTS
   ============================================================ */

-- 1. CRM customer info: count missing and duplicate customer IDs
SELECT
    'bronze.crm_cust_info' AS table_name,
    SUM(CASE WHEN cst_id IS NULL THEN 1 ELSE 0 END) AS null_customer_ids,
    COUNT(cst_id) - COUNT(DISTINCT cst_id) AS duplicate_customer_ids
FROM bronze.crm_cust_info;

-- Find blank names and unexpected marital status or gender codes
SELECT *
FROM bronze.crm_cust_info
WHERE cst_firstname IS NULL OR TRIM(cst_firstname) = ''
   OR cst_lastname IS NULL OR TRIM(cst_lastname) = ''
   OR (cst_marital_status IS NOT NULL
       AND UPPER(TRIM(cst_marital_status)) NOT IN ('S', 'M'))
   OR (cst_gndr IS NOT NULL
       AND UPPER(TRIM(cst_gndr)) NOT IN ('F', 'M'));

-- Find customers whose latest records have tied creation dates
WITH ranked_customers AS (
    SELECT
        cst_id,
        cst_create_date,
        DENSE_RANK() OVER (
            PARTITION BY cst_id
            ORDER BY cst_create_date DESC
        ) AS date_rank
    FROM bronze.crm_cust_info
    WHERE cst_id IS NOT NULL
)
SELECT cst_id, cst_create_date
FROM ranked_customers
WHERE date_rank = 1
  AND cst_id IN (
      SELECT cst_id
      FROM ranked_customers
      WHERE date_rank = 1
      GROUP BY cst_id
      HAVING COUNT(*) > 1
  );


-- 2. CRM product info: count missing and duplicate product IDs
SELECT
    'bronze.crm_prd_info' AS table_name,
    SUM(CASE WHEN prd_id IS NULL THEN 1 ELSE 0 END) AS null_product_ids,
    COUNT(prd_id) - COUNT(DISTINCT prd_id) AS duplicate_product_ids
FROM bronze.crm_prd_info;

-- Find missing keys or names, invalid costs, date ranges, and product line codes
SELECT *
FROM bronze.crm_prd_info
WHERE prd_key IS NULL OR TRIM(prd_key) = ''
   OR prd_nm IS NULL OR TRIM(prd_nm) = ''
   OR prd_cost < 0
   OR prd_start_dt IS NULL
   OR (prd_end_dt IS NOT NULL AND prd_end_dt < prd_start_dt)
   OR (prd_line IS NOT NULL
       AND UPPER(TRIM(prd_line)) NOT IN ('M', 'R', 'S', 'T'));

-- Find repeated start dates for the same product key
SELECT
    prd_key,
    prd_start_dt,
    COUNT(*) AS rows_with_same_start_date
FROM bronze.crm_prd_info
GROUP BY prd_key, prd_start_dt
HAVING COUNT(*) > 1;


-- 3. CRM sales details: find missing identifiers and invalid values
SELECT *
FROM bronze.crm_sales_details
WHERE sls_ord_num IS NULL OR TRIM(sls_ord_num) = ''
   OR sls_prd_key IS NULL OR TRIM(sls_prd_key) = ''
   OR sls_cust_id IS NULL
   OR sls_quantity IS NULL OR sls_quantity <= 0
   OR sls_price IS NULL
   OR sls_sales IS NULL OR sls_sales <= 0;

-- Find dates that are zero, not eight digits, or invalid YYYYMMDD dates
SELECT *
FROM bronze.crm_sales_details
WHERE sls_order_dt = 0
   OR LEN(CONVERT(VARCHAR(20), sls_order_dt)) <> 8
   OR TRY_CONVERT(DATE, CONVERT(CHAR(8), sls_order_dt), 112) IS NULL
   OR sls_ship_dt = 0
   OR LEN(CONVERT(VARCHAR(20), sls_ship_dt)) <> 8
   OR TRY_CONVERT(DATE, CONVERT(CHAR(8), sls_ship_dt), 112) IS NULL
   OR sls_due_dt = 0
   OR LEN(CONVERT(VARCHAR(20), sls_due_dt)) <> 8
   OR TRY_CONVERT(DATE, CONVERT(CHAR(8), sls_due_dt), 112) IS NULL;

-- Find rows where sales do not equal quantity multiplied by absolute price
SELECT *
FROM bronze.crm_sales_details
WHERE sls_sales IS NOT NULL
  AND sls_quantity IS NOT NULL
  AND sls_price IS NOT NULL
  AND sls_sales <> sls_quantity * ABS(sls_price);


/* ============================================================
   ERP DATA QUALITY TESTS
   ============================================================ */

-- 4. ERP customer: count missing and duplicate customer IDs
SELECT
    'bronze.erp_cust_az12' AS table_name,
    SUM(CASE
            WHEN erp_CID IS NULL OR TRIM(erp_CID) = '' THEN 1
            ELSE 0
        END) AS missing_customer_ids,
    COUNT(erp_CID) - COUNT(DISTINCT erp_CID) AS duplicate_customer_ids
FROM bronze.erp_cust_az12;

-- Find future birth dates and unexpected gender values
SELECT *
FROM bronze.erp_cust_az12
WHERE erp_BDATE > CAST(GETDATE() AS DATE)
   OR (erp_GEN IS NOT NULL
       AND UPPER(TRIM(erp_GEN)) NOT IN ('F', 'FEMALE', 'M', 'MALE'));


-- 5. ERP location: count missing and duplicate customer IDs
SELECT
    'bronze.erp_loc_a101' AS table_name,
    SUM(CASE
            WHEN erp_CID IS NULL OR TRIM(erp_CID) = '' THEN 1
            ELSE 0
        END) AS missing_customer_ids,
    COUNT(erp_CID) - COUNT(DISTINCT erp_CID) AS duplicate_customer_ids
FROM bronze.erp_loc_a101;

-- Find missing country values and country codes not explicitly mapped
SELECT *
FROM bronze.erp_loc_a101
WHERE erp_CNTRY IS NULL
   OR TRIM(erp_CNTRY) = ''
   OR UPPER(TRIM(erp_CNTRY)) NOT IN ('DE', 'US', 'USA');


-- 6. ERP product categories: count missing and duplicate category IDs
SELECT
    'bronze.erp_px_cat_g1v2' AS table_name,
    SUM(CASE
            WHEN erp_ID IS NULL OR TRIM(erp_ID) = '' THEN 1
            ELSE 0
        END) AS missing_category_ids,
    COUNT(erp_ID) - COUNT(DISTINCT erp_ID) AS duplicate_category_ids
FROM bronze.erp_px_cat_g1v2;

-- Find missing category, subcategory, or maintenance values
SELECT *
FROM bronze.erp_px_cat_g1v2
WHERE erp_CAT IS NULL OR TRIM(erp_CAT) = ''
   OR erp_SUBCAT IS NULL OR TRIM(erp_SUBCAT) = ''
   OR erp_MAINTENANCE IS NULL OR TRIM(erp_MAINTENANCE) = '';
