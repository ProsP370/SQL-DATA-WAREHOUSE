/*
===============================================================================
Gold Layer Data Quality Checks
===============================================================================

Purpose:
    Validate the completeness, uniqueness, and consistency of the Gold layer
    product and customer dimensions and sales fact view. The checks identify
    missing identifiers or measures, duplicate keys, unmatched dimension
    references, and sales date sequences that may need review.

Views checked:
    Gold.dim_products
    Gold.dim_customers
    Gold.fact_sales

Usage:
    Run this script after the Gold views have been created. Review any rows
    returned by a check. A check passes when it returns no rows.

Assumptions:
    - Product_number uniquely identifies a product.
    - customer_id uniquely identifies a customer.
    - Each sales record should match a product and a customer.
    - Ship_date and Due_date should not precede Order_date.
===============================================================================
*/


-- 1. Products: missing product keys or business numbers
SELECT *
FROM Gold.dim_products
WHERE Product_key IS NULL
   OR Product_number IS NULL;


-- 2. Products: duplicate surrogate keys
SELECT
    Product_key,
    COUNT(*) AS duplicate_count
FROM Gold.dim_products
GROUP BY Product_key
HAVING COUNT(*) > 1;


-- 3. Products: duplicate product numbers
SELECT
    Product_number,
    COUNT(*) AS duplicate_count
FROM Gold.dim_products
GROUP BY Product_number
HAVING COUNT(*) > 1;


-- 4. Products: missing or blank product names
SELECT *
FROM Gold.dim_products
WHERE Product_name IS NULL
   OR LTRIM(RTRIM(Product_name)) = '';


-- 5. Customers: missing customer keys or IDs
SELECT *
FROM Gold.dim_customers
WHERE Customer_key IS NULL
   OR customer_id IS NULL;


-- 6. Customers: duplicate surrogate keys
SELECT
    Customer_key,
    COUNT(*) AS duplicate_count
FROM Gold.dim_customers
GROUP BY Customer_key
HAVING COUNT(*) > 1;


-- 7. Customers: duplicate customer IDs
SELECT
    customer_id,
    COUNT(*) AS duplicate_count
FROM Gold.dim_customers
GROUP BY customer_id
HAVING COUNT(*) > 1;


-- 8. Customers: missing or blank customer numbers
SELECT *
FROM Gold.dim_customers
WHERE customer_number IS NULL
   OR LTRIM(RTRIM(customer_number)) = '';


-- 9. Customers: missing or blank names
SELECT *
FROM Gold.dim_customers
WHERE first_name IS NULL
   OR LTRIM(RTRIM(first_name)) = ''
   OR last_name IS NULL
   OR LTRIM(RTRIM(last_name)) = '';


-- 10. Sales: missing order number, dimension keys, or measures
SELECT *
FROM Gold.fact_sales
WHERE Order_number IS NULL
   OR Product_key IS NULL
   OR Customer_key IS NULL
   OR Sales IS NULL
   OR Quantity IS NULL
   OR Price IS NULL;


-- 11. Sales: product keys with no matching product
SELECT fs.*
FROM Gold.fact_sales AS fs
LEFT JOIN Gold.dim_products AS dp
    ON fs.Product_key = dp.Product_key
WHERE dp.Product_key IS NULL;


-- 12. Sales: customer keys with no matching customer
SELECT fs.*
FROM Gold.fact_sales AS fs
LEFT JOIN Gold.dim_customers AS dc
    ON fs.Customer_key = dc.Customer_key
WHERE dc.Customer_key IS NULL;


-- 13. Sales: order date later than ship date
SELECT *
FROM Gold.fact_sales
WHERE Order_date > Ship_date;


-- 14. Sales: order date later than due date
SELECT *
FROM Gold.fact_sales
WHERE Order_date > Due_date;
